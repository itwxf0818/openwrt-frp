#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: Apache-2.0
# OpenWrt uses BusyBox ash, which supports local variables.
# shellcheck disable=SC3043
USE_PROCD=1
START=95
STOP=10

start_service() {
	local enabled config_file
	config_load frpc
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0
	config_get config_file main config_file /etc/frp/frpc.toml
	case "$config_file" in
		/*) ;;
		*) logger -t frpc 'config_file must be an absolute path'; return 1 ;;
	esac
	[ -r "$config_file" ] || { logger -t frpc 'configuration is not readable'; return 1; }
	if grep -q 'CHANGE_ME_WITH_A_LONG_RANDOM_TOKEN' "$config_file"; then
		logger -t frpc 'replace the example token before enabling the service'
		return 1
	fi
	/usr/bin/frpc verify -c "$config_file" || return 1
	procd_open_instance main
	procd_set_param command /usr/bin/frpc -c "$config_file"
	procd_set_param respawn 3600 5 5
	procd_set_param file "$config_file"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits core="0"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger frpc
}

reload_service() {
	stop
	start
}
