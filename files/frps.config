config init 'service'
	option uci_format 'toml'
	# New installations stay off until configured. Existing UCI is preserved.
	option enabled '0'
	option stdout '1'
	option stderr '1'
	option respawn '1'
	# Optional complete native INI/TOML file; when set, conf sections are ignored.
	# option config_file '/etc/frp/frps.toml'

config conf 'common'
	option bind_addr '127.0.0.1'
	option bind_port '7000'
	option proxy_bind_addr '127.0.0.1'
	option tls_force 'true'
	option token 'CHANGE_ME_WITH_A_LONG_RANDOM_TOKEN'
	option log_file 'console'
	option log_level 'info'
